{
  "sheet": "hooks",
  "about": "People Playground 1.27.18 API the mod uses. Mods are C# source compiled by the game's sandboxed ppgModCompiler (no file IO, reflection or external DLLs), so the Strayed side runs outside the game in the baker.",
  "columns": {
    "id": "stable id",
    "purpose": "what the mod does there",
    "ppgClass": "class in People Playground_Data/Managed/Assembly-CSharp.dll (or UnityEngine)",
    "ppgMember": "member used",
    "verified": "true once found in the installed game's assemblies"
  },
  "rows": [
    {"id": "map_loaded", "purpose": "notice a map load and drop the crate", "ppgClass": "MapLoaderBehaviour", "ppgMember": "CurrentMap (static field, polled each frame)", "verified": true},
    {"id": "view_centre", "purpose": "place the crate in view", "ppgClass": "UnityEngine.Camera", "ppgMember": "main", "verified": true},
    {"id": "register_item", "purpose": "add each Strayed item and the crate to the catalog", "ppgClass": "ModAPI", "ppgMember": "Register(Modification)", "verified": true},
    {"id": "load_sprite", "purpose": "load a baked sprite from the mod folder", "ppgClass": "ModAPI", "ppgMember": "LoadSprite(string, float, bool)", "verified": true},
    {"id": "spawn_item", "purpose": "spawn the crate and its contents like the catalog does", "ppgClass": "CatalogBehaviour", "ppgMember": "Main.PerformInstantiation(SpawnableAsset, Vector3, ref bool, float)", "verified": true},
    {"id": "fix_colliders", "purpose": "refit colliders to the new sprite", "ppgClass": "Utils", "ppgMember": "FixColliders(GameObject)", "verified": true},
    {"id": "light", "purpose": "give the torch light", "ppgClass": "ModAPI", "ppgMember": "CreateLight(Transform, Color, float, float)", "verified": true},
    {"id": "activate", "purpose": "open the crate when the player uses it", "ppgClass": "MonoBehaviour message", "ppgMember": "Use(ActivationPropagation)", "verified": true}
  ]
}
