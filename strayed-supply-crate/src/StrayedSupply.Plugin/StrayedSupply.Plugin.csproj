<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds on a PC with Animal Company + BepInEx 6 (IL2CPP) installed and run once, so
       BepInEx/interop holds the generated game assemblies:
       dotnet build -c Release -p:AcDir="C:\...\Animal Company" -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>StrayedSupply</AssemblyName>
    <AcDir Condition="'$(AcDir)' == ''">$(ANIMAL_COMPANY_DIR)</AcDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\StrayedSupply.Core\StrayedSupply.Core.csproj" />
    <Reference Include="$(AcDir)\BepInEx\core\*.dll" Private="false" />
    <Reference Include="$(AcDir)\BepInEx\interop\*.dll" Private="false" />
  </ItemGroup>
</Project>
